name: CIPP Frontend CI/CD

on:
  push:
    branches: [ main ]     # <-- change to 'dev' if your SWA deploys from dev
  workflow_dispatch:

jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: true

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      # Robust install: use yarn if yarn.lock exists, else npm
      - name: Install dependencies
        run: |
          if [ -f yarn.lock ]; then
            corepack enable || true
            yarn install --frozen-lockfile
          else
            npm ci
          fi

      # Build (CIPP should export to ./out for SWA)
      - name: Build
        run: |
          if [ -f yarn.lock ]; then
            yarn build
          else
            npm run build
          fi

      # Diagnose common failure (no 'out' folder)
      - name: Verify build output
        run: |
          echo "Listing ./out (should exist):"
          ls -la out || (echo "::error::Missing 'out' folder. Check your build script exports static site to 'out'." && exit 1)

      # Fail fast if secret missing (common cause)
      - name: Check SWA token secret exists
        env:
          SWA_TOKEN: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN_LIVELY_FIELD_0A9978E10 }}
        run: |
          if [ -z "$SWA_TOKEN" ]; then
            echo "::error::Secret AZURE_STATIC_WEB_APPS_API_TOKEN_LIVELY_FIELD_0A9978E10 is not set in repo settings."
            exit 1
          fi

      - name: Deploy to Azure SWA
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN_LIVELY_FIELD_0A9978E10 }}
          action: upload
          app_location: "/"
          output_location: "out"
