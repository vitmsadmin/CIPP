name: CIPP Frontend CI/CD

on:
  push:
    branches: [ main ]        # <-- change to [ dev ] if your SWA watches dev
  workflow_dispatch:

jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    name: Build and Deploy
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: true

      - uses: actions/setup-node@v4
        with:
          node-version: '22.12.0'

      # Install using yarn if present, else npm
      - name: Install dependencies
        run: |
          if [ -f yarn.lock ]; then
            corepack enable || true
            yarn install --frozen-lockfile
          else
            npm ci
          fi

      # Build (CIPP v7+ should export to ./out)
      - name: Build
        run: |
          if [ -f yarn.lock ]; then
            yarn build
          else
            npm run build
          fi

      # Sanity check: ensure ./out exists
      - name: Verify build output
        run: |
          ls -la out || (echo "::error::Missing 'out' folder. Check that the build script does a static export to 'out'." && exit 1)

      # Deploy to Azure Static Web Apps (upload prebuilt ./out)
      - name: Deploy to Azure SWA
        uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN_LIVELY_FIELD_0A9978E10 }}  # <-- keep this name exactly as in your repo secrets
          action: upload
          app_location: "out"         # we're uploading the built folder directly
          skip_app_build: true        # don't try to build again
